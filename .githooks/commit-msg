#!/bin/sh
# 校验提交信息是否符合 CONTRIBUTING.md 的「提交」一节，规则由 xtask 实现。

set -u

msg_file=${1:-}
[ -n "$msg_file" ] && [ -f "$msg_file" ] || exit 0

if ! command -v cargo >/dev/null 2>&1; then
    echo "提交信息校验需要 cargo，但当前 PATH 里找不到它" >&2
    exit 1
fi

exec cargo run --quiet --locked -p tuack-xtask -- commit-msg "$msg_file"
